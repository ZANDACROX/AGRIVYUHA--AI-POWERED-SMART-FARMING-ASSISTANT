{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":19477141}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/arunodoypramanik/tomato-dataset-95-56-accuracy?scriptVersionId=351292068\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"cell_type":"code","source":"##### ============================================================\n# TOMATO LEAF DISEASE CLASSIFICATION\n# EfficientNetV2B0, 2x T4, leakage-safe splits, staged fine-tuning\n# (top 30% unfreeze) -- extended epochs + targeted oversampling\n# ============================================================\n#\n# Pipeline:\n#   1. Locate dataset on Kaggle\n#   2. Collect TRAIN and TEST images across 11 classes\n#      (10 diseases + 1 healthy)\n#   3. Remove any TRAIN image that is an exact duplicate of a TEST\n#      image (fixes train/test leakage)\n#   4. Oversample the powdery_mildew class (see below)\n#   5. Split TEST into VALIDATION and FINAL TEST, keeping every\n#      copy of a duplicated image together in one split\n#   6. Phase 1: train a new classification head on a frozen\n#      EfficientNetV2B0 backbone\n#   7. Phase 2: fine-tune the top ~30% of the backbone at a low\n#      learning rate\n#   8. Evaluate on the held-out FINAL TEST set: accuracy,\n#      macro/weighted precision/recall/F1, full classification\n#      report, confusion matrix (numeric + heatmap image),\n#      training curves\n#\n# CHANGES FROM THE 95.42%-ACCURACY RUN (which completed cleanly,\n# no NaN, no hangs, but was still improving when it hit its\n# epoch ceiling):\n#   - INITIAL_EPOCHS 20 -> 26, FINE_TUNE_EPOCHS 15 -> 28. Val_loss\n#     was still decreasing every epoch in both phases at the end\n#     of the last run -- this just raises the ceiling; EarlyStopping\n#     (patience=5) still governs actual stopping.\n#   - BATCH_SIZE 32 -> 48. A moderate efficiency bump. This is\n#     unrelated to either previously-fixed root cause (the NaN was\n#     fp16 overflow, the hang was NCCL P2P negotiation -- neither\n#     is batch-size-dependent), so this shouldn't reopen either\n#     issue.\n#   - Targeted oversampling for powdery_mildew (3x). Its confusion\n#     with a handful of other classes has persisted across every\n#     run regardless of loss weighting alone, most likely because\n#     it has 3-9x fewer TRAIN images than every other class. This\n#     brings it roughly into line with the other smaller classes.\n#     Because augmentation is stochastic, each repeated copy gets\n#     an independently different augmented view every epoch, so\n#     this also acts as extra augmentation diversity, not just\n#     repetition. The \"balanced\" class-weight formula runs AFTER\n#     oversampling, so it will automatically compute a smaller,\n#     more sensible weight for this class rather than double-\n#     stacking oversampling and heavy loss-weighting together.\n#   - Output filenames now end in \"_extended\" so this experimental\n#     run cannot overwrite the good 95.42% checkpoint/plots from\n#     the previous run.\n# ============================================================\n\nimport os\n\n# Kaggle's 2xT4 instances lack NVLink between the GPUs, and NCCL's\n# peer-to-peer handshake over that link is a known source of silent\n# training hangs (no error -- it just stops progressing). Disabling\n# P2P forces communication through host memory instead, which is\n# slightly slower but far more reliable on this hardware. Must be\n# set before TensorFlow initializes CUDA/NCCL, hence right here at\n# the top, before the tensorflow import below.\nos.environ.setdefault(\"NCCL_P2P_DISABLE\", \"1\")\n\nimport glob\nimport zipfile\nimport hashlib\nimport random\nimport warnings\n\nimport numpy as np\nimport tensorflow as tf\nimport matplotlib.pyplot as plt\n\nfrom tensorflow.keras.applications import EfficientNetV2B0\nfrom tensorflow.keras.applications.efficientnet_v2 import preprocess_input as backbone_preprocess\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.utils.class_weight import compute_class_weight\nfrom sklearn.metrics import (\n    classification_report,\n    confusion_matrix,\n    accuracy_score,\n    precision_score,\n    recall_score,\n    f1_score\n)\n\nwarnings.filterwarnings(\"ignore\")\n\nprint(\"TensorFlow version:\", tf.__version__)\n\n\n# ============================================================\n# 1. REPRODUCIBILITY\n# ============================================================\n\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntf.random.set_seed(SEED)\n\n\n# ============================================================\n# 2. CONFIGURATION\n# ============================================================\n\nBATCH_SIZE = 48                     # 32 -> 48, moderate efficiency bump\nIMG_SIZE = (224, 224)\nNUM_CLASSES_EXPECTED = 11\nVALIDATION_FRACTION = 0.50          # of the cleaned TEST set\n\nINITIAL_EPOCHS = 26                 # Phase 1: frozen backbone (was 20)\nFINE_TUNE_EPOCHS = 28               # Phase 2: fine-tuning, additional (was 15)\nUNFREEZE_FRACTION = 0.30            # fraction of backbone layers to unfreeze\n\nPHASE1_LR = 1e-3\nFINE_TUNE_LR = 1e-5\n\nMAX_CLASS_WEIGHT = 2.5              # caps how hard rare classes get boosted\n\nOVERSAMPLE_CLASS_NAME = \"powdery_mildew\"\nOVERSAMPLE_FACTOR = 3               # 1,004 -> ~3,012 TRAIN images\n\nCHECKPOINT_PATH = \"/kaggle/working/best_tomato_model_extended.keras\"\nFINAL_MODEL_PATH = \"/kaggle/working/tomato_disease_effnetv2b0_extended_final.keras\"\nLOG_CSV_PATH = \"/kaggle/working/training_log_extended.csv\"\nCONFUSION_MATRIX_PNG = \"/kaggle/working/confusion_matrix_extended.png\"\nTRAINING_CURVES_PNG = \"/kaggle/working/training_curves_extended.png\"\n\n\n# ============================================================\n# 3. GPU + MULTI-GPU STRATEGY\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"GPU CONFIGURATION\")\nprint(\"=\" * 75)\n\ngpu_devices = tf.config.list_physical_devices(\"GPU\")\n\n# Grappler's layout optimizer has a known issue with EfficientNet's\n# internal stochastic-depth SelectV2 op (\"layout failed\" errors). Disabling\n# it just skips that one graph optimization pass -- no effect on model\n# correctness or accuracy.\ntf.config.optimizer.set_experimental_options({\"layout_optimizer\": False})\n\nif gpu_devices:\n    print(f\"GPUs detected: {len(gpu_devices)}\")\n    for i, gpu in enumerate(gpu_devices):\n        print(f\"  GPU {i}: {gpu.name}\")\n        try:\n            tf.config.experimental.set_memory_growth(gpu, True)\n        except Exception:\n            pass\nelse:\n    print(\"WARNING: No GPU detected. In Kaggle: Settings -> Accelerator -> GPU T4 x2\")\n\nstrategy = tf.distribute.MirroredStrategy(\n    cross_device_ops=tf.distribute.ReductionToOneDevice()\n)\nprint(f\"\\nSynchronized devices: {strategy.num_replicas_in_sync}\")\nif strategy.num_replicas_in_sync != 2:\n    print(\"WARNING: Expected 2 GPUs for 2xT4 training.\")\n\n\n# ============================================================\n# 4. PRECISION -- MIXED PRECISION DISABLED (fixed the earlier NaN)\n# ============================================================\n\nprint(\"[STATUS] Training in float32 (mixed precision disabled).\")\n\n\n# ============================================================\n# 5. LOCATE DATASET ON KAGGLE\n# ============================================================\n\nINPUT_ROOT = \"/kaggle/input\"\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"SEARCHING KAGGLE INPUT\")\nprint(\"=\" * 75)\n\nfor item in os.listdir(INPUT_ROOT):\n    print(\"  \", item)\n\n\ndef find_directory(root_directory, directory_name):\n    for root, dirs, _ in os.walk(root_directory):\n        for directory in dirs:\n            if directory.lower() == directory_name.lower():\n                return os.path.join(root, directory)\n    return None\n\n\nTRAIN_DIR = find_directory(INPUT_ROOT, \"TRAIN\")\nORIGINAL_TEST_DIR = find_directory(INPUT_ROOT, \"TEST\")\n\nif TRAIN_DIR is None or ORIGINAL_TEST_DIR is None:\n\n    zip_candidates = glob.glob(\"/kaggle/input/**/*.zip\", recursive=True)\n\n    if not zip_candidates:\n        raise FileNotFoundError(\n            \"Could not find TRAIN/TEST folders under /kaggle/input, and no \"\n            \".zip file exists either. Confirm the dataset is attached to \"\n            \"this notebook and check the actual split folder names.\"\n        )\n\n    preferred = [z for z in zip_candidates if \"tomato\" in z.lower() or \"disease\" in z.lower()]\n    zip_path = preferred[0] if preferred else zip_candidates[0]\n\n    extract_dir = \"/kaggle/working/TOMATO_DATASET\"\n    os.makedirs(extract_dir, exist_ok=True)\n\n    print(\"Extracting:\", zip_path)\n    with zipfile.ZipFile(zip_path, \"r\") as zf:\n        zf.extractall(extract_dir)\n\n    TRAIN_DIR = find_directory(extract_dir, \"TRAIN\")\n    ORIGINAL_TEST_DIR = find_directory(extract_dir, \"TEST\")\n\nif TRAIN_DIR is None or ORIGINAL_TEST_DIR is None:\n    raise FileNotFoundError(\"TRAIN and/or TEST directory could not be located.\")\n\nprint(\"\\nTRAIN:\", TRAIN_DIR)\nprint(\"ORIGINAL TEST:\", ORIGINAL_TEST_DIR)\n\n\n# ============================================================\n# 6. HELPERS: IMAGE COLLECTION + HASHING\n# ============================================================\n\nVALID_EXTENSIONS = {\".jpg\", \".jpeg\", \".png\", \".bmp\", \".webp\"}\n\n\ndef collect_images(root_directory, class_names):\n    image_paths, image_labels = [], []\n    for class_index, class_name in enumerate(class_names):\n        class_dir = os.path.join(root_directory, class_name)\n        if not os.path.isdir(class_dir):\n            continue\n        for root, _, files in os.walk(class_dir):\n            for filename in files:\n                if os.path.splitext(filename)[1].lower() in VALID_EXTENSIONS:\n                    image_paths.append(os.path.join(root, filename))\n                    image_labels.append(class_index)\n    return np.array(image_paths), np.array(image_labels)\n\n\ndef calculate_file_hash(file_path, chunk_size=1024 * 1024):\n    sha256 = hashlib.sha256()\n    try:\n        with open(file_path, \"rb\") as f:\n            while True:\n                chunk = f.read(chunk_size)\n                if not chunk:\n                    break\n                sha256.update(chunk)\n        return sha256.hexdigest()\n    except Exception:\n        return None\n\n\ndef hash_all(paths, label_for_log):\n    hashes = []\n    for i, p in enumerate(paths):\n        hashes.append(calculate_file_hash(p))\n        if (i + 1) % 5000 == 0:\n            print(f\"  Hashed {label_for_log}: {i + 1:,} / {len(paths):,}\")\n    return np.array(hashes, dtype=object)\n\n\n# ============================================================\n# 7. DETERMINE CLASSES\n# ============================================================\n\nclass_names = sorted([\n    d for d in os.listdir(TRAIN_DIR) if os.path.isdir(os.path.join(TRAIN_DIR, d))\n])\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"CLASSES\")\nprint(\"=\" * 75)\nfor i, c in enumerate(class_names):\n    print(f\"{i:2d} -> {c}\")\n\nif len(class_names) != NUM_CLASSES_EXPECTED:\n    print(f\"\\nWARNING: expected {NUM_CLASSES_EXPECTED} classes, found {len(class_names)}.\")\n\n\n# ============================================================\n# 8. COLLECT IMAGES\n# ============================================================\n\ntrain_paths, train_labels = collect_images(TRAIN_DIR, class_names)\noriginal_test_paths, original_test_labels = collect_images(ORIGINAL_TEST_DIR, class_names)\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"RAW DATASET SIZE (BEFORE CLEANUP)\")\nprint(\"=\" * 75)\nprint(f\"TRAIN : {len(train_paths):,}\")\nprint(f\"TEST  : {len(original_test_paths):,}\")\n\n\n# ============================================================\n# 9. DEDUPLICATION (LEAKAGE FIX)\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"HASHING IMAGES FOR DEDUPLICATION\")\nprint(\"=\" * 75)\n\ntrain_hashes = hash_all(train_paths, \"TRAIN\")\ntest_hashes = hash_all(original_test_paths, \"TEST\")\n\ntest_hash_set = set(h for h in test_hashes if h is not None)\nleak_mask = np.isin(train_hashes, list(test_hash_set))\nnum_leaked = int(leak_mask.sum())\n\nprint(f\"\\nTRAIN images duplicated in TEST: {num_leaked:,}\")\n\nif num_leaked > 0:\n    train_paths = train_paths[~leak_mask]\n    train_labels = train_labels[~leak_mask]\n    train_hashes = train_hashes[~leak_mask]\n    print(f\"[FIX] Removed from TRAIN. New TRAIN size: {len(train_paths):,}\")\nelse:\n    print(\"[STATUS] No TRAIN/TEST overlap found.\")\n\nunique_test_hash_count = len(set(h if h is not None else i for i, h in enumerate(test_hashes)))\nprint(f\"\\nUnique images in TEST by content: {unique_test_hash_count:,} out of {len(test_hashes):,} files\")\n\npost_fix_train_counts = np.bincount(train_labels, minlength=len(class_names))\nweak_classes = [class_names[i] for i, c in enumerate(post_fix_train_counts) if c < 50]\nif weak_classes:\n    print(f\"\\nWARNING: these classes have fewer than 50 TRAIN images after dedup: {weak_classes}\")\n\n\n# ============================================================\n# 9B. TARGETED OVERSAMPLING (powdery_mildew)\n# ============================================================\n\nif OVERSAMPLE_CLASS_NAME in class_names and OVERSAMPLE_FACTOR > 1:\n\n    oversample_index = class_names.index(OVERSAMPLE_CLASS_NAME)\n    oversample_mask = (train_labels == oversample_index)\n\n    before_count = int(oversample_mask.sum())\n\n    extra_paths = np.tile(train_paths[oversample_mask], OVERSAMPLE_FACTOR - 1)\n    extra_labels = np.tile(train_labels[oversample_mask], OVERSAMPLE_FACTOR - 1)\n\n    train_paths = np.concatenate([train_paths, extra_paths])\n    train_labels = np.concatenate([train_labels, extra_labels])\n\n    print(\"\\n\" + \"=\" * 75)\n    print(\"TARGETED OVERSAMPLING\")\n    print(\"=\" * 75)\n    print(f\"{OVERSAMPLE_CLASS_NAME}: {before_count:,} -> {before_count * OVERSAMPLE_FACTOR:,} \"\n          f\"TRAIN images ({OVERSAMPLE_FACTOR}x)\")\n    print(f\"New TRAIN size: {len(train_paths):,}\")\n\n\n# ============================================================\n# 10. TRAIN CLASS DISTRIBUTION (AFTER DEDUP + OVERSAMPLING)\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"TRAIN CLASS DISTRIBUTION (AFTER DEDUP + OVERSAMPLING)\")\nprint(\"=\" * 75)\n\ntrain_counts = np.bincount(train_labels, minlength=len(class_names))\nfor i, c in enumerate(class_names):\n    print(f\"{c:<35}: {train_counts[i]:>7,}\")\n\n\n# ============================================================\n# 11. SPLIT TEST INTO VALIDATION + FINAL TEST (DUPLICATE-SAFE)\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"SPLITTING TEST INTO VALIDATION + FINAL TEST\")\nprint(\"=\" * 75)\n\nvalidation_paths, validation_labels = [], []\nfinal_test_paths, final_test_labels = [], []\n\nfor class_index, class_name in enumerate(class_names):\n\n    class_idx = np.where(original_test_labels == class_index)[0]\n\n    groups = {}\n    for gi in class_idx:\n        key = test_hashes[gi] if test_hashes[gi] is not None else f\"__unique_{gi}__\"\n        groups.setdefault(key, []).append(gi)\n\n    group_keys = list(groups.keys())\n\n    if len(group_keys) < 2:\n        raise ValueError(f\"Class '{class_name}' has fewer than 2 unique TEST images.\")\n\n    val_keys, test_keys = train_test_split(\n        group_keys,\n        test_size=(1.0 - VALIDATION_FRACTION),\n        random_state=SEED,\n        shuffle=True\n    )\n\n    for k in val_keys:\n        for gi in groups[k]:\n            validation_paths.append(original_test_paths[gi])\n            validation_labels.append(original_test_labels[gi])\n\n    for k in test_keys:\n        for gi in groups[k]:\n            final_test_paths.append(original_test_paths[gi])\n            final_test_labels.append(original_test_labels[gi])\n\nvalidation_paths = np.array(validation_paths)\nvalidation_labels = np.array(validation_labels)\nfinal_test_paths = np.array(final_test_paths)\nfinal_test_labels = np.array(final_test_labels)\n\nval_shuffle = np.random.RandomState(SEED).permutation(len(validation_paths))\nvalidation_paths, validation_labels = validation_paths[val_shuffle], validation_labels[val_shuffle]\n\ntest_shuffle = np.random.RandomState(SEED + 1).permutation(len(final_test_paths))\nfinal_test_paths, final_test_labels = final_test_paths[test_shuffle], final_test_labels[test_shuffle]\n\nprint(f\"Validation images : {len(validation_paths):,}\")\nprint(f\"Final TEST images : {len(final_test_paths):,}\")\n\nvalidation_counts = np.bincount(validation_labels, minlength=len(class_names))\nfinal_test_counts = np.bincount(final_test_labels, minlength=len(class_names))\n\nprint(f\"\\n{'CLASS':<35}{'TRAIN':>10}{'VAL':>10}{'FINAL TEST':>12}\")\nprint(\"-\" * 75)\nfor i, c in enumerate(class_names):\n    print(f\"{c:<35}{train_counts[i]:>10,}{validation_counts[i]:>10,}{final_test_counts[i]:>12,}\")\n\n\n# ============================================================\n# 12. CLASS IMBALANCE / CLASS WEIGHTS (COMPUTED POST-OVERSAMPLING)\n# ============================================================\n\nmin_count, max_count = np.min(train_counts), np.max(train_counts)\nimbalance_ratio = max_count / min_count\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"CLASS IMBALANCE\")\nprint(\"=\" * 75)\nprint(f\"Smallest class: {min_count:,}  |  Largest class: {max_count:,}  |  Ratio: {imbalance_ratio:.2f}x\")\n\nUSE_CLASS_WEIGHTS = imbalance_ratio >= 1.5\n\nif USE_CLASS_WEIGHTS:\n    computed_weights = compute_class_weight(\n        class_weight=\"balanced\",\n        classes=np.arange(len(class_names)),\n        y=train_labels\n    )\n\n    capped_weights = np.clip(computed_weights, None, MAX_CLASS_WEIGHT)\n    num_capped = int(np.sum(capped_weights < computed_weights))\n    if num_capped > 0:\n        print(f\"[STATUS] Capped {num_capped} class weight(s) at {MAX_CLASS_WEIGHT} \"\n              f\"to avoid over-predicting rare classes.\")\n    computed_weights = capped_weights\n\n    class_weights = tf.constant(computed_weights, dtype=tf.float32)\n    print(\"[STATUS] Class weighting ENABLED.\")\n    for i, w in enumerate(computed_weights):\n        print(f\"  {class_names[i]:<35} weight = {w:.4f}\")\nelse:\n    class_weights = tf.ones(len(class_names), dtype=tf.float32)\n    print(\"[STATUS] Classes reasonably balanced -- no class weighting.\")\n\n\n# ============================================================\n# 13. TF.DATA PIPELINES\n# ============================================================\n\nAUTOTUNE = tf.data.AUTOTUNE\n\n\ndef load_and_resize(path, label):\n    image = tf.io.read_file(path)\n    image = tf.image.decode_image(image, channels=3, expand_animations=False)\n    image.set_shape([None, None, 3])\n    image = tf.image.resize(image, IMG_SIZE)\n    image = tf.cast(image, tf.float32)\n    label = tf.one_hot(label, depth=len(class_names))\n    return image, label\n\n\ndef build_dataset(paths, labels, shuffle=False):\n    ds = tf.data.Dataset.from_tensor_slices((paths, labels))\n    if shuffle:\n        ds = ds.shuffle(min(len(paths), 8192), seed=SEED, reshuffle_each_iteration=True)\n    ds = ds.map(load_and_resize, num_parallel_calls=AUTOTUNE)\n    ds = ds.batch(BATCH_SIZE, drop_remainder=False)\n    ds = ds.prefetch(AUTOTUNE)\n    return ds\n\n\ndata_augmentation = tf.keras.Sequential([\n    tf.keras.layers.RandomFlip(\"horizontal\"),\n    tf.keras.layers.RandomRotation(0.15),\n    tf.keras.layers.RandomZoom(0.15),\n    tf.keras.layers.RandomContrast(0.15),\n    tf.keras.layers.RandomBrightness(0.1),\n], name=\"augmentation\")\n\n\ndef preprocess_train(images, labels):\n    images = data_augmentation(images, training=True)\n    images = tf.clip_by_value(images, 0.0, 255.0)\n    images = backbone_preprocess(images)\n    return images, labels\n\n\ndef preprocess_eval(images, labels):\n    images = backbone_preprocess(images)\n    return images, labels\n\n\ntrain_ds = build_dataset(train_paths, train_labels, shuffle=True) \\\n    .map(preprocess_train, num_parallel_calls=AUTOTUNE).prefetch(AUTOTUNE)\n\nvalidation_ds = build_dataset(validation_paths, validation_labels, shuffle=False) \\\n    .map(preprocess_eval, num_parallel_calls=AUTOTUNE).prefetch(AUTOTUNE)\n\nfinal_test_ds = build_dataset(final_test_paths, final_test_labels, shuffle=False) \\\n    .map(preprocess_eval, num_parallel_calls=AUTOTUNE).prefetch(AUTOTUNE)\n\n\n# ============================================================\n# 14. LOSS FUNCTION\n# ============================================================\n\nbase_cce = tf.keras.losses.CategoricalCrossentropy(\n    from_logits=False, label_smoothing=0.1, reduction=tf.keras.losses.Reduction.NONE\n)\n\n\ndef weighted_categorical_crossentropy(y_true, y_pred):\n    y_true = tf.cast(y_true, tf.float32)\n    y_pred = tf.cast(y_pred, tf.float32)\n    per_sample = base_cce(y_true, y_pred)\n    weights = tf.reduce_sum(y_true * class_weights, axis=-1)\n    return tf.reduce_mean(per_sample * weights)\n\n\nLOSS_FUNCTION = weighted_categorical_crossentropy if USE_CLASS_WEIGHTS else \\\n    tf.keras.losses.CategoricalCrossentropy(label_smoothing=0.1)\n\n\n# ============================================================\n# 15. BUILD MODEL: EfficientNetV2B0 + CUSTOM HEAD\n# ============================================================\n\nwith strategy.scope():\n\n    base_model = EfficientNetV2B0(\n        input_shape=(224, 224, 3),\n        include_top=False,\n        weights=\"imagenet\"\n    )\n    base_model.trainable = False\n\n    inputs = tf.keras.Input(shape=(224, 224, 3))\n    x = base_model(inputs, training=False)\n    x = tf.keras.layers.GlobalAveragePooling2D()(x)\n    x = tf.keras.layers.BatchNormalization()(x)\n    x = tf.keras.layers.Dropout(0.4)(x)\n    x = tf.keras.layers.Dense(\n        256, activation=\"relu\",\n        kernel_regularizer=tf.keras.regularizers.l2(1e-4)\n    )(x)\n    x = tf.keras.layers.Dropout(0.3)(x)\n    outputs = tf.keras.layers.Dense(len(class_names), activation=\"softmax\")(x)\n\n    model = tf.keras.Model(inputs, outputs, name=\"Tomato_Disease_EfficientNetV2B0\")\n\nmodel.summary()\n\n\n# ============================================================\n# 16. COMPILE (PHASE 1) + CALLBACKS\n# ============================================================\n\nwith strategy.scope():\n    model.compile(\n        optimizer=tf.keras.optimizers.Adam(learning_rate=PHASE1_LR, clipnorm=1.0),\n        loss=LOSS_FUNCTION,\n        metrics=[\"accuracy\"]\n    )\n\ncallbacks = [\n    tf.keras.callbacks.EarlyStopping(\n        monitor=\"val_loss\", patience=5, restore_best_weights=True,\n        start_from_epoch=5, verbose=1\n    ),\n    tf.keras.callbacks.ReduceLROnPlateau(\n        monitor=\"val_loss\", factor=0.2, patience=3, min_lr=1e-7, verbose=1\n    ),\n    tf.keras.callbacks.ModelCheckpoint(\n        filepath=CHECKPOINT_PATH, monitor=\"val_accuracy\", save_best_only=True, verbose=1\n    ),\n    tf.keras.callbacks.CSVLogger(LOG_CSV_PATH, append=True),\n    tf.keras.callbacks.TerminateOnNaN(),\n]\n\n\n# ============================================================\n# 17. PHASE 1 TRAINING (FROZEN BACKBONE)\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"PHASE 1: TRAINING CLASSIFICATION HEAD\")\nprint(\"=\" * 75)\n\nhistory_phase1 = model.fit(\n    train_ds,\n    validation_data=validation_ds,\n    epochs=INITIAL_EPOCHS,\n    callbacks=callbacks\n)\n\n\n# ============================================================\n# 18. FINE-TUNING SETUP (TOP 30% OF BACKBONE)\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"PHASE 2: FINE-TUNING EfficientNetV2B0\")\nprint(\"=\" * 75)\n\nbase_model.trainable = True\n\ntotal_layers = len(base_model.layers)\nfreeze_up_to = int(total_layers * (1 - UNFREEZE_FRACTION))\n\nfor layer in base_model.layers[:freeze_up_to]:\n    layer.trainable = False\n\nprint(f\"Backbone layers: {total_layers} total, {freeze_up_to} frozen, \"\n      f\"{total_layers - freeze_up_to} trainable\")\n\nwith strategy.scope():\n    model.compile(\n        optimizer=tf.keras.optimizers.Adam(learning_rate=FINE_TUNE_LR, clipnorm=0.5),\n        loss=LOSS_FUNCTION,\n        metrics=[\"accuracy\"]\n    )\n\n\n# ============================================================\n# 19. PHASE 2 TRAINING (FINE-TUNING)\n# ============================================================\n\nTOTAL_EPOCHS = INITIAL_EPOCHS + FINE_TUNE_EPOCHS\nprint(f\"\\nTotal epochs planned: {TOTAL_EPOCHS}\")\n\nhistory_fine = model.fit(\n    train_ds,\n    validation_data=validation_ds,\n    epochs=TOTAL_EPOCHS,\n    initial_epoch=history_phase1.epoch[-1] + 1,\n    callbacks=callbacks\n)\n\n\n# ============================================================\n# 20. LOAD BEST MODEL\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"LOADING BEST CHECKPOINT\")\nprint(\"=\" * 75)\n\nbest_model = tf.keras.models.load_model(CHECKPOINT_PATH, compile=False)\nprint(\"[STATUS] Best model loaded.\")\n\n\n# ============================================================\n# 21. FINAL TEST EVALUATION\n# ============================================================\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"FINAL TEST EVALUATION\")\nprint(\"=\" * 75)\n\ny_pred_probs = best_model.predict(final_test_ds, verbose=1)\ny_pred = np.argmax(y_pred_probs, axis=1)\ny_true = final_test_labels\n\ntest_accuracy = accuracy_score(y_true, y_pred)\nmacro_precision = precision_score(y_true, y_pred, average=\"macro\", zero_division=0)\nmacro_recall = recall_score(y_true, y_pred, average=\"macro\", zero_division=0)\nmacro_f1 = f1_score(y_true, y_pred, average=\"macro\", zero_division=0)\nweighted_f1 = f1_score(y_true, y_pred, average=\"weighted\", zero_division=0)\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"FINAL TEST METRICS\")\nprint(\"=\" * 75)\nprint(f\"Test Accuracy     : {test_accuracy:.4f}\")\nprint(f\"Macro Precision   : {macro_precision:.4f}\")\nprint(f\"Macro Recall      : {macro_recall:.4f}\")\nprint(f\"Macro F1-score    : {macro_f1:.4f}\")\nprint(f\"Weighted F1-score : {weighted_f1:.4f}\")\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"CLASSIFICATION REPORT\")\nprint(\"=\" * 75)\nprint(classification_report(y_true, y_pred, target_names=class_names, digits=4, zero_division=0))\n\nclass_recalls = recall_score(\n    y_true, y_pred, average=None, labels=np.arange(len(class_names)), zero_division=0\n)\nprint(\"=\" * 75)\nprint(\"PER-CLASS RECALL\")\nprint(\"=\" * 75)\nfor i, c in enumerate(class_names):\n    print(f\"{c:<35}: {class_recalls[i]:.4f}\")\n\n\n# ============================================================\n# 22. CONFUSION MATRIX (NUMERIC + HEATMAP)\n# ============================================================\n\ncm = confusion_matrix(y_true, y_pred)\nprint(\"\\nCONFUSION MATRIX (raw counts)\")\nprint(cm)\n\nfig, ax = plt.subplots(figsize=(11, 9))\nim = ax.imshow(cm, cmap=\"Blues\")\nax.set_xticks(range(len(class_names)))\nax.set_yticks(range(len(class_names)))\nax.set_xticklabels(class_names, rotation=90)\nax.set_yticklabels(class_names)\nax.set_xlabel(\"Predicted\")\nax.set_ylabel(\"Actual\")\nax.set_title(\"Confusion Matrix -- Final Test Set\")\n\nthresh = cm.max() / 2.0\nfor i in range(cm.shape[0]):\n    for j in range(cm.shape[1]):\n        ax.text(\n            j, i, format(cm[i, j], \"d\"),\n            ha=\"center\", va=\"center\",\n            color=\"white\" if cm[i, j] > thresh else \"black\",\n            fontsize=7\n        )\n\nfig.colorbar(im, ax=ax)\nplt.tight_layout()\nplt.savefig(CONFUSION_MATRIX_PNG, dpi=150)\nplt.show()\n\n\n# ============================================================\n# 23. TRAINING CURVES\n# ============================================================\n\nacc = history_phase1.history[\"accuracy\"] + history_fine.history[\"accuracy\"]\nval_acc = history_phase1.history[\"val_accuracy\"] + history_fine.history[\"val_accuracy\"]\nloss = history_phase1.history[\"loss\"] + history_fine.history[\"loss\"]\nval_loss = history_phase1.history[\"val_loss\"] + history_fine.history[\"val_loss\"]\n\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\naxes[0].plot(acc, label=\"train\")\naxes[0].plot(val_acc, label=\"validation\")\naxes[0].axvline(len(history_phase1.history[\"accuracy\"]) - 0.5, color=\"gray\", linestyle=\"--\", label=\"fine-tune start\")\naxes[0].set_title(\"Accuracy\")\naxes[0].set_xlabel(\"Epoch\")\naxes[0].legend()\n\naxes[1].plot(loss, label=\"train\")\naxes[1].plot(val_loss, label=\"validation\")\naxes[1].axvline(len(history_phase1.history[\"loss\"]) - 0.5, color=\"gray\", linestyle=\"--\", label=\"fine-tune start\")\naxes[1].set_title(\"Loss\")\naxes[1].set_xlabel(\"Epoch\")\naxes[1].legend()\n\nplt.tight_layout()\nplt.savefig(TRAINING_CURVES_PNG, dpi=150)\nplt.show()\n\n\n# ============================================================\n# 24. SAVE FINAL MODEL\n# ============================================================\n\nbest_model.save(FINAL_MODEL_PATH)\n\nprint(\"\\n\" + \"=\" * 75)\nprint(\"TRAINING COMPLETE\")\nprint(\"=\" * 75)\nprint(\"Best checkpoint :\", CHECKPOINT_PATH)\nprint(\"Final model     :\", FINAL_MODEL_PATH)\nprint(\"Training log    :\", LOG_CSV_PATH)\nprint(\"Confusion matrix:\", CONFUSION_MATRIX_PNG)\nprint(\"Training curves :\", TRAINING_CURVES_PNG)\nprint(\"=\" * 75)","metadata":{"execution":{"iopub.status.busy":"2026-09-14T10:21:02.80739Z","iopub.execute_input":"2026-09-14T10:21:02.807984Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# TOMATO DISEASE MODEL -- STANDALONE FINAL EVALUATION\n# ============================================================\n#\n# Loads the already-trained best checkpoint and reconstructs the\n# EXACT same FINAL TEST split used during training (same class\n# ordering, same duplicate-safe stratified split, same SEED) so\n# the numbers here match what the training run would have shown.\n# No retraining happens -- this only loads and evaluates.\n#\n# Paste this as a NEW cell in the same Kaggle notebook (after your\n# training cell, or in a fresh session -- it re-discovers the\n# dataset either way). Update CHECKPOINT_PATH / LOG_CSV_PATH below\n# if you're evaluating a different run.\n# ============================================================\n\nimport os\n\nos.environ.setdefault(\"NCCL_P2P_DISABLE\", \"1\")\n\nimport glob\nimport hashlib\nimport random\nimport zipfile\nimport warnings\n\nimport numpy as np\nimport pandas as pd\nimport tensorflow as tf\nimport matplotlib.pyplot as plt\n\nfrom tensorflow.keras.applications.efficientnet_v2 import preprocess_input as backbone_preprocess\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import (\n    classification_report,\n    confusion_matrix,\n    accuracy_score,\n    precision_score,\n    recall_score,\n    f1_score\n)\n\nwarnings.filterwarnings(\"ignore\")\n\n\n# ============================================================\n# CONFIGURATION -- must match the training run being evaluated\n# ============================================================\n\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntf.random.set_seed(SEED)\n\nIMG_SIZE = (224, 224)\nBATCH_SIZE = 48\nVALIDATION_FRACTION = 0.50\nNUM_CLASSES_EXPECTED = 11\n\nCHECKPOINT_PATH = \"/kaggle/working/best_tomato_model_extended.keras\"\nLOG_CSV_PATH = \"/kaggle/working/training_log_extended.csv\"\nCONFUSION_MATRIX_PNG = \"/kaggle/working/confusion_matrix_extended_eval.png\"\nTRAINING_CURVES_PNG = \"/kaggle/working/training_curves_extended_eval.png\"\n\n\n# ============================================================\n# GPU CONFIG (safe to re-run even if GPUs are already initialized\n# from an earlier cell in this same session)\n# ============================================================\n\ngpu_devices = tf.config.list_physical_devices(\"GPU\")\ntf.config.optimizer.set_experimental_options({\"layout_optimizer\": False})\nfor gpu in gpu_devices:\n    try:\n        tf.config.experimental.set_memory_growth(gpu, True)\n    except Exception:\n        pass\nprint(f\"GPUs detected: {len(gpu_devices)}\")\n\n\n# ============================================================\n# LOCATE DATASET\n# ============================================================\n\nINPUT_ROOT = \"/kaggle/input\"\n\n\ndef find_directory(root_directory, directory_name):\n    for root, dirs, _ in os.walk(root_directory):\n        for directory in dirs:\n            if directory.lower() == directory_name.lower():\n                return os.path.join(root, directory)\n    return None\n\n\nTRAIN_DIR = find_directory(INPUT_ROOT, \"TRAIN\")\nORIGINAL_TEST_DIR = find_directory(INPUT_ROOT, \"TEST\")\n\nif TRAIN_DIR is None or ORIGINAL_TEST_DIR is None:\n\n    zip_candidates = glob.glob(\"/kaggle/input/**/*.zip\", recursive=True)\n    if not zip_candidates:\n        raise FileNotFoundError(\"Could not find TRAIN/TEST folders or a .zip under /kaggle/input.\")\n\n    preferred = [z for z in zip_candidates if \"tomato\" in z.lower() or \"disease\" in z.lower()]\n    zip_path = preferred[0] if preferred else zip_candidates[0]\n\n    extract_dir = \"/kaggle/working/TOMATO_DATASET\"\n    os.makedirs(extract_dir, exist_ok=True)\n    with zipfile.ZipFile(zip_path, \"r\") as zf:\n        zf.extractall(extract_dir)\n\n    TRAIN_DIR = find_directory(extract_dir, \"TRAIN\")\n    ORIGINAL_TEST_DIR = find_directory(extract_dir, \"TEST\")\n\nprint(\"TRAIN:\", TRAIN_DIR)\nprint(\"ORIGINAL TEST:\", ORIGINAL_TEST_DIR)\n\n\n# ============================================================\n# CLASS NAMES (must match training order exactly -- same sorted\n# listing of TRAIN_DIR subfolders as the training script used)\n# ============================================================\n\nclass_names = sorted([\n    d for d in os.listdir(TRAIN_DIR) if os.path.isdir(os.path.join(TRAIN_DIR, d))\n])\n\nprint(\"\\nClasses:\")\nfor i, c in enumerate(class_names):\n    print(f\"{i:2d} -> {c}\")\n\nif len(class_names) != NUM_CLASSES_EXPECTED:\n    print(f\"WARNING: expected {NUM_CLASSES_EXPECTED} classes, found {len(class_names)}.\")\n\n\n# ============================================================\n# COLLECT + HASH TEST IMAGES, REBUILD THE DUPLICATE-SAFE SPLIT\n# ============================================================\n#\n# Note: this only needs the TEST folder. The train/test dedup and\n# oversampling from training don't affect which images ended up in\n# the FINAL TEST split, so none of that needs to be redone here.\n# ============================================================\n\nVALID_EXTENSIONS = {\".jpg\", \".jpeg\", \".png\", \".bmp\", \".webp\"}\n\n\ndef collect_images(root_directory, class_names):\n    image_paths, image_labels = [], []\n    for class_index, class_name in enumerate(class_names):\n        class_dir = os.path.join(root_directory, class_name)\n        if not os.path.isdir(class_dir):\n            continue\n        for root, _, files in os.walk(class_dir):\n            for filename in files:\n                if os.path.splitext(filename)[1].lower() in VALID_EXTENSIONS:\n                    image_paths.append(os.path.join(root, filename))\n                    image_labels.append(class_index)\n    return np.array(image_paths), np.array(image_labels)\n\n\ndef calculate_file_hash(file_path, chunk_size=1024 * 1024):\n    sha256 = hashlib.sha256()\n    try:\n        with open(file_path, \"rb\") as f:\n            while True:\n                chunk = f.read(chunk_size)\n                if not chunk:\n                    break\n                sha256.update(chunk)\n        return sha256.hexdigest()\n    except Exception:\n        return None\n\n\noriginal_test_paths, original_test_labels = collect_images(ORIGINAL_TEST_DIR, class_names)\nprint(f\"\\nOriginal TEST images: {len(original_test_paths):,}\")\n\nprint(\"Hashing TEST images (needed to reproduce the exact split)...\")\ntest_hashes = []\nfor i, p in enumerate(original_test_paths):\n    test_hashes.append(calculate_file_hash(p))\n    if (i + 1) % 5000 == 0:\n        print(f\"  Hashed: {i + 1:,} / {len(original_test_paths):,}\")\ntest_hashes = np.array(test_hashes, dtype=object)\n\nvalidation_paths, validation_labels = [], []\nfinal_test_paths, final_test_labels = [], []\n\nfor class_index, class_name in enumerate(class_names):\n\n    class_idx = np.where(original_test_labels == class_index)[0]\n\n    groups = {}\n    for gi in class_idx:\n        key = test_hashes[gi] if test_hashes[gi] is not None else f\"__unique_{gi}__\"\n        groups.setdefault(key, []).append(gi)\n\n    group_keys = list(groups.keys())\n\n    val_keys, test_keys = train_test_split(\n        group_keys,\n        test_size=(1.0 - VALIDATION_FRACTION),\n        random_state=SEED,\n        shuffle=True\n    )\n\n    for k in val_keys:\n        for gi in groups[k]:\n            validation_paths.append(original_test_paths[gi])\n            validation_labels.append(original_test_labels[gi])\n\n    for k in test_keys:\n        for gi in groups[k]:\n            final_test_p